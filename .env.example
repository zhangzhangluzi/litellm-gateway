# Copy to .env and fill values. NEVER commit .env. chmod 600 .env
# Domain must already point DNS A/AAAA to this VPS before Caddy can get a cert.

DOMAIN=llm.example.com

# Master key for clients (same role as this box's /workspace/.litellm_master_key)
# Generate: openssl rand -hex 32   then prefix with sk-
LITELLM_MASTER_KEY=

# Only needed if you enable the with-db profile / Admin UI credential encryption
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=

# ---- Provider keys (names only; fill on VPS from your password manager) ----
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
UPSTAGE_API_KEY=
COHERE_API_KEY=
AI_GATEWAY_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
SILICONFLOW_API_KEY=

# Cloudflare Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_BASE is computed in docker-compose.yml from ACCOUNT_ID
